# Foundry build output
out/
cache/
artifacts/

# Foundry script artifacts. Dry runs are pure noise; real broadcast records are kept so a
# deployment stays reproducible and auditable.
broadcast/*

# Environment files — never commit a real key
.env
.env.local
.env.*.local

# Editors / tooling
.claude/
.idea/
.vscode/
*.swp
*.swo

# Remix IDE workspace artifacts
.deps/
remix.config.json

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/
coverage.json
lcov.info

# Tenderly
tenderly/

# Node (if any)
node_modules/

# NOTE: do not add broad markdown patterns here. This file previously carried `*-*.md` and
# `DE*.md`, which silently excluded DEPLOYMENT.md and REVIEW-2026-09-13.md — both linked from
# README — so anyone cloning the repo got broken links and lost the audit record. Documentation
# lives in the repo; exclude individual files by exact name if one ever needs to stay local.

# RPC endpoint
RPC_URL=

# Deployer private key — NEVER commit a real key
PRIVATE_KEY=

# Uniswap v4 pool manager address on target chain
POOL_MANAGER_ADDRESS=

# Protocol admin address (may pause protocol-fee collection and withdraw revenue)
ADMIN_ADDRESS=

# Fee parameters (in 1e6 units; 1% = 10000, 0.01% = 100)
# Require 0 <= MIN_FEE <= MAX_FEE < 1000000; C <= 2^128 - 1.
# The centre bucket carries a 3x weight, so `local` peaks at 3x global when every bit of recent
# volume sits in the current tick bucket. The raw fee is L*C/local, which is CONTINUOUS and
# monotone in the window's share of global volume -- there is no cliff:
#
#   window holds 100% of recent volume -> C/3      (with C=300: 100 pips)
#   window holds  40%                  -> ~250 pips
#   window holds  10%                  -> ~1000 pips
#   window holds   1% or less          -> clamped to MAX_FEE
#
# So MIN_FEE binds only when raw < MIN_FEE (and in the L == 0 no-volume-anywhere case), while
# MAX_FEE binds across a whole range of thin-window states, not just the empty one.
# C scales the entire curve, not just its floor: halving C halves the fee at every window share.
#
# TICK_SPACING is coupled to all of this. What drives the signal is how many buckets a typical
# trade moves the price across. Too coarse and every trade lands in the centre bucket, pinning
# the fee at C/3; too fine and the window empties often, pinning it at MAX_FEE. Measured over
# the same +-2000 tick path (see test history), mean fee was 1302 / 708 / 405 / 186 pips at
# spacings 10 / 30 / 60 / 200 -- the spacing moves the fee more than any other single knob.
MIN_FEE=100
MAX_FEE=3000
FEE_CONSTANT_C=300

# Volume base token: true = token0, false = token1
BASE_TOKEN_IS_TOKEN0=true

# Pool configuration (script sorts currencies; the base flag refers to that sorted order)
TOKEN0_ADDRESS=
TOKEN1_ADDRESS=
TICK_SPACING=30
INITIAL_SQRT_PRICE=79228162514264337593543950336

# The deterministic CREATE2 proxy must already exist at
# 0x4e59b44847b379578588920cA78FbF26c0B4956C on the target chain.
